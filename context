        testId: Int,
        status: String
    ): Result<AttendanceResponse> {
        return try {
            val response = apiService.markAttendance(
                MarkAttendanceRequest(rollNumber, testId, status, getDeviceInfo())
            )
            if (response.isSuccessful) {
                Result.success(response.body()!!)
            } else {
                Result.failure(Exception(response.message()))
            }
        } catch (e: Exception) {
            // Queue for offline sync
            localDb.attendanceDao().insert(
                AttendanceEntity(rollNumber, testId, status, synced = false)
            )
            Result.failure(e)
        }
    }
}
